    <!-- Process Section -->
    <section id="process" class="process">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">Proceso Inteligente</h2>
                <p class="section-description">Un flujo optimizado que convierte datos en decisiones y emociones en resultados</p>
            </div>
            <div class="process-timeline">
                <div class="process-step">
                    <div class="step-number">1</div>
                    <div class="step-content">
                        <h3 class="step-title">Captación</h3>
                        <p class="step-description">
                            Recopilamos y organizamos datos relevantes para construir audiencias 
                            segmentadas con alta intención de conversión.
                        </p>
                    </div>
                </div>
                <div class="process-step">
                    <div class="step-number">2</div>
                    <div class="step-content">
                        <h3 class="step-title">Enriquecimiento</h3>
                        <p class="step-description">
                            Analizamos intereses, patrones de compra y señales contextuales para 
                            crear perfiles dinámicos y predictivos.
                        </p>
                    </div>
                </div>
                <div class="process-step">
                    <div class="step-number">3</div>
                    <div class="step-content">
                        <h3 class="step-title">Análisis Emocional Previo</h3>
                        <p class="step-description">
                            Evaluamos el estado emocional de cada segmento antes del envío, ajustando 
                            contenido, tono y timing para lograr mayor conexión.
                        </p>
                    </div>
                </div>
                <div class="process-step">
                    <div class="step-number">4</div>
                    <div class="step-content">
                        <h3 class="step-title">Activación</h3>
                        <p class="step-description">
                            Ejecutamos campañas personalizadas que se adaptan al perfil y contexto 
                            emocional de cada destinatario.
                        </p>
                    </div>
                </div>
                <div class="process-step">
                    <div class="step-number">5</div>
                    <div class="step-content">
                        <h3 class="step-title">Optimización</h3>
                        <p class="step-description">
                            Medimos impacto y ROI, ajustando automáticamente las estrategias para 
                            mejorar resultados en cada iteración.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>






















