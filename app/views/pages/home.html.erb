    function showAuthModal() {
        // Redirigir a la página de registro
        window.location.href = '/users/sign_up'
    }
    
    function showEmailConfirmationAlert() {
        alert('Por favor confirma tu email para acceder a nuestros servicios. Revisa tu bandeja de entrada y spam.')
    }
    
    function initializeInputValidation() {
        const industryInput = document.querySelector('[data-radar-target="industryInput"]')
        const searchBtn = document.querySelector('[data-radar-target="searchBtn"]')
        
        console.log('=== INITIALIZING INPUT VALIDATION ===')
        console.log('Industry input:', industryInput)
        console.log('Search button:', searchBtn)
        
        if (industryInput && searchBtn) {
            // Initialize button as disabled
            searchBtn.disabled = true
            searchBtn.classList.add('btn-secondary')
            console.log('Button initialized as disabled')
            
            // Add event listener for input validation
            industryInput.addEventListener('input', function() {
                const value = this.value.trim()
                const isValid = value.length >= 3
                
                console.log('Input changed - value:', value, 'length:', value.length, 'isValid:', isValid)
                
                if (isValid) {
                    searchBtn.disabled = false
                    searchBtn.classList.remove('btn-secondary')
                    searchBtn.classList.add('btn-primary')
                    console.log('Button ENABLED')
                } else {
                    searchBtn.disabled = true
                    searchBtn.classList.remove('btn-primary')
                    searchBtn.classList.add('btn-secondary')
                    console.log('Button DISABLED')
                }
            })
            
            // Add event listener for search button
            searchBtn.addEventListener('click', function() {
                const industry = industryInput.value.trim()
                console.log('Search button clicked, industry:', industry)
                if (industry.length >= 3) {
                    console.log('Starting wizard for industry:', industry)
                    startWizardSteps(industry)
                } else {
                    console.log('Industry too short, not starting wizard')
                }
            })
            
            console.log('Input validation initialized successfully')
        } else {
            console.error('Input or button not found!')
            console.log('Retrying in 1 second...')
            setTimeout(initializeInputValidation, 1000)
        }
    }
    
    function startWizardSteps(industry) {
        console.log('Starting wizard steps for:', industry)
        
        const inputPanel = document.querySelector('[data-radar-target="inputPanel"]')
        const stepsPanel = document.querySelector('[data-radar-target="stepsPanel"]')
        const industryDisplay = document.querySelector('[data-radar-target="industryDisplay"]')
        
        console.log('Wizard panels:', { inputPanel, stepsPanel, industryDisplay })
        
        if (inputPanel && stepsPanel && industryDisplay) {
            // Hide input panel and show steps panel
            inputPanel.style.display = 'none'
            stepsPanel.style.display = 'block'
            
            // Update industry display
            industryDisplay.textContent = industry
            
            // Start progress animation
            startProgressAnimation()
            
            console.log('Wizard started successfully')
        } else {
            console.error('Wizard panels not found!')
        }
    }
    
    function startProgressAnimation() {
        const progressFill = document.querySelector('[data-radar-target="progressFill"]')
        const progressBar = document.querySelector('[data-radar-target="progressBar"]')
        const stepTitle = document.querySelector('[data-radar-target="stepTitle"]')
        const stepDescription = document.querySelector('[data-radar-target="stepDescription"]')
        const stepIcon = document.querySelector('[data-radar-target="stepIcon"]')
        const wizardAction = document.querySelector('[data-radar-target="wizardAction"]')
        
        const steps = [
            {
                title: "Perfil inicial",
                description: "Se selecciona un perfil B2B con datos enriquecidos y completos",
                icon: "https://cdn.lordicon.com/iubtdgvu.json",
                progress: 20
            },
            {
                title: "Contexto inteligente", 
                description: "Se analiza información actualizada de noticias, redes y actividad reciente",
                icon: "https://cdn.lordicon.com/jgeruqwm.json",
                progress: 40
            },
            {
                title: "Personalización emocional",
                description: "Se construye una ficha con tono, intereses y motivadores clave",
                icon: "https://cdn.lordicon.com/iiudwewg.json",
                progress: 60
            },
            {
                title: "Validación",
                description: "Se verifica que el perfil cumple con criterios ideales para outreach",
                icon: "https://cdn.lordicon.com/vysppwvq.json",
                progress: 80
            },
            {
                title: "Listo para contactar",
                description: "El prospecto está listo para recibir un mensaje emocionalmente resonante",
                icon: "https://cdn.lordicon.com/zvamcipt.json",
                progress: 100
            }
        ]
        
        let currentStep = 0
        
        function updateStep() {
            if (currentStep < steps.length) {
                const step = steps[currentStep]
                
                // Update progress bar
                if (progressFill) {
                    progressFill.style.width = step.progress + '%'
                }
                if (progressBar) {
                    progressBar.setAttribute('aria-valuenow', step.progress)
                }
                
                // Update step info
                if (stepTitle) stepTitle.textContent = step.title
                if (stepDescription) stepDescription.textContent = step.description
                if (stepIcon) {
                    stepIcon.innerHTML = `<lord-icon src="${step.icon}" trigger="loop" delay="2000" stroke="light" style="width:40px;height:40px"></lord-icon>`
                }
                
                // Update step labels
                updateStepLabels(currentStep)
                
                currentStep++
                
                if (currentStep < steps.length) {
                    setTimeout(updateStep, 2000) // 2 seconds per step
                } else {
                    // Show action button when complete
                    if (wizardAction) {
                        wizardAction.style.display = 'block'
                    }
                }
            }
        }
        
        // Start animation
        setTimeout(updateStep, 500)
    }
    
    function updateStepLabels(activeIndex) {
        for (let i = 1; i <= 5; i++) {
            const label = document.querySelector(`[data-radar-target="stepLabel${i}"]`)
            if (label) {
                label.classList.remove('active', 'completed')
                if (i < activeIndex + 1) {
                    label.classList.add('completed')
                } else if (i === activeIndex + 1) {
                    label.classList.add('active')
                }
            }
        }
    }
    
    function initiateOutreach() {
        console.log('Initiating outreach...')
        alert('¡Outreach iniciado! El mensaje emocionalmente resonante ha sido enviado al prospecto.')
        
        // Reset wizard
        resetWizard()
    }
    
    function resetWizard() {
        const inputPanel = document.querySelector('[data-radar-target="inputPanel"]')
        const stepsPanel = document.querySelector('[data-radar-target="stepsPanel"]')
        const industryInput = document.querySelector('[data-radar-target="industryInput"]')
        const progressFill = document.querySelector('[data-radar-target="progressFill"]')
        const progressBar = document.querySelector('[data-radar-target="progressBar"]')
        const wizardAction = document.querySelector('[data-radar-target="wizardAction"]')
        
        // Show input panel and hide steps panel
        if (inputPanel) inputPanel.style.display = 'block'
        if (stepsPanel) stepsPanel.style.display = 'none'
        
        // Clear input
        if (industryInput) industryInput.value = ''
        
        // Reset progress
        if (progressFill) progressFill.style.width = '0%'
        if (progressBar) progressBar.setAttribute('aria-valuenow', '0')
        if (wizardAction) wizardAction.style.display = 'none'
        
        // Reset step labels
        for (let i = 1; i <= 5; i++) {
            const label = document.querySelector(`[data-radar-target="stepLabel${i}"]`)
            if (label) {
                label.classList.remove('active', 'completed')
            }
        }
        
        // Re-initialize input validation
        initializeInputValidation()
    }
    
    function closeRadarDemo() {
        console.log('Closing radar demo...')
        const demoSection = document.getElementById('demo-servicios')
        if (demoSection) {
            demoSection.style.display = 'none'
            // Reset wizard when closing
            resetWizard()
        }
    }
    </script>
